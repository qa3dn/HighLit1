DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost
DB_ENGINE=django.db.backends.postgresql
DB_NAME=highlit
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
CHANNEL_LAYER_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379/0
# Payment gateway webhook secrets (HMAC-SHA256). Leave blank in manual mode —
# the webhook then fails closed (rejects all events). Set when integrating CliQ/Click.
CLIQ_WEBHOOK_SECRET=
CLICK_WEBHOOK_SECRET=
# Manual Click/CliQ checkout: where companies transfer to (shown at checkout).
PAYMENT_PROVIDER=Click
PAYMENT_CLICK_ID=HIGHLIT@CLIQ
PAYMENT_ACCOUNT_NAME=HighLit
PAYMENT_INSTRUCTIONS=حوّل المبلغ عبر تطبيق Click/CliQ إلى الحساب أعلاه، ثم أدخل رقم العملية وأرفق إيصال التحويل.
